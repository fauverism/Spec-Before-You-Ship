---
import { lessons } from '../data/lessons';

interface Props {
  title: string;
  lessonNum: number;
  description?: string;
}

const { title, lessonNum, description } = Astro.props;

const currentIndex = lessons.findIndex(l => l.num === lessonNum);
const prevLesson = currentIndex > 0 ? lessons[currentIndex - 1] : null;
const nextLesson = currentIndex < lessons.length - 1 ? lessons[currentIndex + 1] : null;
const counter = `${String(lessonNum).padStart(2, '0')} / ${lessons.length}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — Spec Before You Ship</title>
  {description && <meta name="description" content={description}>}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Code:wght@400;500&family=Source+Sans+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&display=swap" rel="stylesheet">
  <script is:inline>
    try {
      var t = localStorage.getItem('theme');
      var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (t === 'dark' || (!t && d)) document.documentElement.classList.add('dark');
    } catch(e) {}
  </script>
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="stylesheet" href="/assets/lesson.css">
  {lessonNum === 1 && <link rel="stylesheet" href="/assets/lesson-01.css">}
  <slot name="head" />
</head>
<body>

<div class="mob-nav">
  {prevLesson
    ? <a href={`/lessons/${prevLesson.slug}/`} class="mob-nav-arrow">←</a>
    : <span class="mob-nav-arrow hidden">←</span>
  }
  <span class="mob-nav-counter">{counter}</span>
  {nextLesson
    ? <a href={`/lessons/${nextLesson.slug}/`} class="mob-nav-arrow">→</a>
    : <span class="mob-nav-arrow hidden">→</span>
  }
</div>

<div class="layout">

  <aside class="sidebar">
    <div class="sidebar-label">Tutorial</div>
    <div class="sidebar-title">Spec Before You Ship</div>

    <nav>
      {lessons.map(lesson => (
        lesson.num === lessonNum
          ? <a href="#" class="current"><span class="num">{String(lesson.num).padStart(2, '0')}</span>{lesson.title}</a>
          : <a href={`/lessons/${lesson.slug}/`}><span class="num">{String(lesson.num).padStart(2, '0')}</span>{lesson.title}</a>
      ))}
    </nav>

    <div class="sidebar-theme">
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <svg id="icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <svg id="icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none"><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.22 3.22l1.42 1.42M11.36 11.36l1.42 1.42M11.36 4.64l1.42-1.42M3.22 12.78l1.42-1.42" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </button>
    </div>

    <div class="sidebar-signup">
      <div class="ss-label">Stay Updated</div>
      <form
        action="https://buttondown.com/api/emails/embed-subscribe/fauver"
        method="post"
        class="embeddable-buttondown-form"
      >
        <label for="bd-email">Enter your email</label>
        <input type="email" name="email" id="bd-email" />
        <input type="submit" value="Subscribe" />
        <p>
          <a href="https://buttondown.com/refer/fauver" target="_blank">Powered by Buttondown.</a>
        </p>
      </form>
    </div>
  </aside>

  <slot />

</div>

<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-copy">&copy; 2026 BridgeSpec &mdash; <span class="footer-attribution">Created by <a href="https://robertfauver.com">Robert Fauver</a></span></span>
    <ul class="footer-links">
      <li><a href="/">Home</a></li>
      <li><a href="/lessons/01-the-chaos-tax/">Start Learning</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
    <span class="footer-version">v0.0.3-alpha</span>
  </div>
</footer>

  <slot name="body-end" />
  <script is:inline>
(function () {
  var html = document.documentElement;
  var btn = document.getElementById('theme-toggle');
  var moon = document.getElementById('icon-moon');
  var sun = document.getElementById('icon-sun');

  function applyIcons(dark) {
    moon.style.display = dark ? 'none' : 'block';
    sun.style.display  = dark ? 'block' : 'none';
  }

  applyIcons(html.classList.contains('dark'));

  btn.addEventListener('click', function () {
    var isDark = html.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch(e) {}
    applyIcons(isDark);
  });
}());
  </script>
  <script is:inline>
(function () {
  var COPY_ICON = '<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4.5" y="4.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2"/><path d="M2 9V2.5C2 1.67 2.67 1 3.5 1H10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>';
  var CHECK_ICON = '<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 7L5.5 10L11.5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  function makeBtn(getCode) {
    var btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', 'Copy code');
    btn.innerHTML = COPY_ICON;
    btn.addEventListener('click', function () {
      var text = getCode();
      navigator.clipboard.writeText(text).then(function () {
        btn.innerHTML = CHECK_ICON;
        btn.classList.add('copy-btn--copied');
        setTimeout(function () {
          btn.innerHTML = COPY_ICON;
          btn.classList.remove('copy-btn--copied');
        }, 1500);
      });
    });
    return btn;
  }

  document.querySelectorAll('.code-block').forEach(function (block) {
    var header = block.querySelector('.code-header');
    var code = block.querySelector('code');
    if (!header || !code) return;
    var btn = makeBtn(function () { return code.innerText; });
    header.appendChild(btn);
  });

  document.querySelectorAll('.shell-block, .file-tree').forEach(function (block) {
    var code = block.querySelector('code');
    if (!code) return;
    block.style.position = 'relative';
    var btn = makeBtn(function () { return code.innerText; });
    btn.classList.add('copy-btn--overlay');
    block.appendChild(btn);
  });
}());
  </script>
</body>
</html>
